# Copy this file to .env and fill in the values.
# Do NOT commit .env to source control.

# ---------------------------------------------------------------------------
# Microsoft Foundry (Azure AI Foundry) project
# ---------------------------------------------------------------------------
# Full project endpoint, e.g. https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_ENDPOINT=

# Deployed model name (deployment name in your Foundry project), e.g. gpt-4o-mini
FOUNDRY_MODEL_NAME=

# Optional judge-model deployment for Control Plane lab 03 (defaults to gpt-4.1)
FOUNDRY_EVALUATION_MODEL_NAME=

# ---------------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------------
# Service endpoint, e.g. https://<your-search-service>.search.windows.net
AI_SEARCH_ENDPOINT=

# Admin key (full read/write). Use only for setup/indexing scripts.
AI_SEARCH_ADMIN_KEY=

# Query key (read-only). Use for querying from applications.
AI_SEARCH_QUERY_KEY=

# Default index name used by the labs
AI_SEARCH_INDEX_NAME=

# ---------------------------------------------------------------------------
# Azure subscription context (used by Control Plane labs)
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_TENANT_ID=

# ---------------------------------------------------------------------------
# Observability (Application Insights — used by tracing lab)
# ---------------------------------------------------------------------------
# Connection string from your Application Insights resource attached to the Foundry project
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Azure API Management (used by AI Gateway - APIM labs)
# ---------------------------------------------------------------------------
APIM_SERVICE_NAME=
APIM_GATEWAY_URL=              # e.g. https://<apim-name>.azure-api.net
APIM_SUBSCRIPTION_KEY=         # subscription key for the "AI" product / API
APIM_AOAI_API_PATH=openai      # path segment where the AOAI API is mounted (default: openai)

# ---------------------------------------------------------------------------
# Azure Managed Redis (used by semantic caching lab)
# ---------------------------------------------------------------------------
AZURE_REDIS_NAME=
AZURE_REDIS_HOST=              # e.g. <name>.redis.cache.windows.net

# ---------------------------------------------------------------------------
# Microsoft Purview (used by Microsoft Purview labs)
# ---------------------------------------------------------------------------
PURVIEW_ACCOUNT_NAME=          # your Purview account short name
PURVIEW_ENDPOINT=              # https://<account>.purview.azure.com
# Graph endpoints used by the Purview Data Security APIs (ProtectionScopes / ProcessContent)
GRAPH_BASE_URL=https://graph.microsoft.com/beta
# Optional AI Search resource for the "Purview + AI Search" lab (reuses AI_SEARCH_* vars from Foundry lab)

# ---------------------------------------------------------------------------
# Microsoft Agent 365 (used by Agent 365 labs)
# ---------------------------------------------------------------------------
# Graph beta base URL (reuses GRAPH_BASE_URL from Purview labs)
# Entra app with delegated permissions:
#   Agent.Read.All, Agent.ReadWrite.All, SecurityEvents.Read.All, InformationProtectionPolicy.Read
AGENT365_APP_CLIENT_ID=
# Zava demo agent object IDs (populated after registering agents in the Agent 365 directory)
ZAVA_PROCUREMENT_AGENT_ID=
ZAVA_SUPPLIER_AGENT_ID=
ZAVA_SUPPORT_AGENT_ID=


# ---------------------------------------------------------------------------
# Microsoft Entra Agent ID (used by Entra Agent ID labs)
# ---------------------------------------------------------------------------
# Dedicated Entra app registration for provisioning blueprints/principals/identities.
# NOTE: DefaultAzureCredential/az-cli tokens are hard-rejected by Agent Identity APIs.
# Assign one of: Agent Identity Developer, Agent Identity Administrator, or Application Administrator.
ENTRA_AGENTID_CLIENT_ID=
ENTRA_AGENTID_CLIENT_SECRET=
# IDs populated after running lab 01
ZAVA_SALES_BLUEPRINT_APP_ID=
ZAVA_SALES_BLUEPRINT_OBJECT_ID=
ZAVA_SALES_BLUEPRINT_PRINCIPAL_ID=
ZAVA_SALES_AGENT_IDENTITY_ID=


# ---------------------------------------------------------------------------
# Microsoft Defender for Cloud / Defender for AI (used by Defender labs)
# ---------------------------------------------------------------------------
# Log Analytics workspace ID where Defender/Sentinel ingest AI alerts (advanced hunting)
DEFENDER_LOG_ANALYTICS_WORKSPACE_ID=
# Optional: Sentinel workspace resource id  (/subscriptions/.../workspaces/xxx)
SENTINEL_WORKSPACE_RESOURCE_ID=
# Foundry account resource id for the Zava Assist agent (used by attack-path lab)
ZAVA_ASSIST_AGENT_RESOURCE_ID=

